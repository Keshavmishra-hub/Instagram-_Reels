# Copy to .env and fill in what you have. Every key is optional - features degrade gracefully.
# Never commit .env.

# --- Claude (research with web search + fetch, script, storyboard, captions) -----------------
# Get a key: https://console.anthropic.com/ -> API Keys. Without it, use Claude Code mode (README).
ANTHROPIC_API_KEY=
# REELFORGE_MODEL=claude-opus-5-5          # or claude-sonnet-5-5 for lower cost
# REELFORGE_MAX_SEARCHES=10
# REELFORGE_MAX_FETCHES=14

# --- Stock footage & photos (free) ------------------------------------------------------------
# Pexels: https://www.pexels.com/api/  (free key, instant)
PEXELS_API_KEY=
# Pixabay: https://pixabay.com/api/docs/  (free key after sign-up)
PIXABAY_API_KEY=
# Wikimedia Commons and NASA Image Library need no key (set to 0 to disable)
# REELFORGE_WIKIMEDIA=1
# REELFORGE_NASA=1

# --- Voices (Kokoro runs locally for free; these are optional upgrades) -----------------------
# Azure AI Speech (free tier ~0.5M chars/month, best Indian-language neural voices):
#   https://portal.azure.com -> Create "Speech service" -> Keys and Endpoint
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia
# ElevenLabs (premium voices, word timings included): https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# OpenAI TTS (gpt-4o-mini-tts): https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- Rendering ----------------------------------------------------------------------------------
# REELFORGE_CHROME=/path/to/chrome-headless-shell   # default: Remotion downloads its own
# REELFORGE_RENDER_CONCURRENCY=4
# REELFORGE_ASR=sherpa                               # force the offline English recogniser
# REELFORGE_WHISPER_MODEL=small                      # faster-whisper model size
